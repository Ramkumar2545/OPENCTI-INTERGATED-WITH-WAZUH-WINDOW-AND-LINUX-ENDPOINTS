  <rule id="100736" level="12">
    <if_group>opencti_alert_obs</if_group>
    <field name="opencti.type" type="pcre2">(?i)^Vulnerability$</field>
    <description>OpenCTI Alert: CVE Observable Matched in Threat Intel [Score: $(opencti.observable.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_vuln,</group>
    <mitre>
