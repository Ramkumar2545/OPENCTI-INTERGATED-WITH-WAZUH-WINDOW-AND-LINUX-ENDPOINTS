<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SECTION 4 — Native log_source Correlation Rules            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<group name="opencti,opencti_native_context,">

  <rule id="101300" level="12">
    <if_sid>100720,100721</if_sid>
    <field name="opencti.source.log_source">^windows_logon$</field>
    <description>OpenCTI Alert: Malicious IP Matched Windows Logon Event (4624/4625) [Author: $(opencti.author_name)] - $(opencti.source.ipAddress)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_native_context,opencti_windows_logon,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="101301" level="12">
    <if_sid>100720,100721</if_sid>
    <field name="opencti.source.log_source">^linux_auth$</field>
    <description>OpenCTI Alert: Malicious IP Matched Linux Authentication Log [Author: $(opencti.author_name)] - $(opencti.source.srcip)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_native_context,opencti_linux_auth,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="101302" level="12">
    <if_sid>100725,100726</if_sid>
    <field name="opencti.source.log_source">^web_log$</field>
    <description>OpenCTI Alert: Malicious $(opencti.ioc_type) Matched Web Log Entry [Author: $(opencti.author_name)] - $(opencti.source.url)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_native_context,opencti_web_log,</group>
    <mitre>
      <id>T1071.001</id>
    </mitre>
  </rule>

  <rule id="101303" level="12">
    <if_sid>100720,100721,100725,100726</if_sid>
    <field name="opencti.source.log_source">^dns_log$</field>
    <description>OpenCTI Alert: DNS Query/Answer Matched Threat Intel [Author: $(opencti.author_name)] - $(opencti.source.dns_query)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_native_context,opencti_dns,</group>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <rule id="101304" level="13">
    <if_sid>100720,100721</if_sid>
    <field name="opencti.source.log_source">^firewall$</field>
    <description>OpenCTI Alert: Firewall-Permitted Outbound Connection Matched Threat Intel [Author: $(opencti.author_name)] - $(opencti.source.dstip)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_native_context,opencti_firewall,</group>
    <mitre>
      <id>T1071</id>
      <id>T1041</id>
    </mitre>
  </rule>

  <rule id="101305" level="13">
    <if_sid>100720,100721,100725,100726,100730,100731,100735,100736</if_sid>
    <field name="opencti.source.log_source" type="pcre2">^(?:powershell_script|windows_process_creation|linux_process_creation)$</field>
    <description>OpenCTI Alert: Malicious $(opencti.ioc_type) in Command/Script Execution [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_native_context,opencti_process_creation,opencti_powershell,</group>
    <mitre>
      <id>T1059</id>
      <id>T1059.001</id>
      <id>T1071</id>
    </mitre>
  </rule>

</group>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SECTION 5 — Sighting Write-Back Confirmation               -->
<!-- ═══════════════════════════════════════════════════════════ -->
<group name="opencti,opencti_sighting,">

  <rule id="100714" level="3">
    <if_group>opencti_alert</if_group>
    <field name="opencti.sighting_id" type="pcre2">.+</field>
    <description>OpenCTI: Sighting Recorded - $(opencti.query_values) [Author: $(opencti.author_name)] (Sighting ID: $(opencti.sighting_id))</description>
    <options>no_full_log</options>
    <group>opencti,opencti_sighting,opencti_sighting_confirmed,</group>
  </rule>

</group>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SECTION 6 — Local Heuristics (OpenCTI had no match at all)  -->
<!--  Fires only when custom-opencti.py's evaluate_local_heuristic()  -->
<!--  found something — i.e. OpenCTI returned neither an indicator   -->
<!--  nor an observable for this IOC. No CDB list, no automation     -->
<!--  platform involved anywhere in this block.                      -->
<!--  ID block reserved: 101400-101410 (clear of 100690-100736 and   -->
<!--  101300-101305 used above).                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<group name="opencti,opencti_local_heuristic,">

  <rule id="101400" level="9">
    <if_sid>100700</if_sid>
    <field name="opencti.event_type">^local_heuristic_match$</field>
    <description>OpenCTI Add-on: Local heuristic flagged $(opencti.ioc_type) not present in threat intel - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
  </rule>

  <rule id="101401" level="10">
    <if_sid>101400</if_sid>
    <field name="opencti.local.check">suspicious_tld</field>
    <description>OpenCTI Add-on: Domain uses high-abuse TLD - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
  </rule>

  <rule id="101402" level="10">
    <if_sid>101400</if_sid>
    <field name="opencti.local.check">dynamic_dns_provider</field>
    <description>OpenCTI Add-on: Endpoint contacted free dynamic-DNS/tunneling domain - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
    <mitre>
      <id>T1568</id>
    </mitre>
  </rule>

  <rule id="101403" level="12">
    <if_sid>101400</if_sid>
    <field name="opencti.local.check">dga_heuristic_score</field>
    <description>OpenCTI Add-on: High-entropy / DGA-scored domain - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
    <mitre>
      <id>T1568.002</id>
    </mitre>
  </rule>

  <rule id="101404" level="9">
    <if_sid>101400</if_sid>
    <field name="opencti.local.check">raw_ip_url</field>
    <description>OpenCTI Add-on: URL points directly at a raw IP instead of a domain - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
    <mitre>
      <id>T1102</id>
    </mitre>
  </rule>

  <rule id="101405" level="8">
    <if_sid>101400</if_sid>
    <field name="opencti.local.check">punycode_homograph</field>
    <description>OpenCTI Add-on: Punycode/homograph domain pattern - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
    <mitre>
      <id>T1583.001</id>
    </mitre>
  </rule>

  <rule id="101406" level="9">
    <if_sid>101400</if_sid>
    <field name="opencti.local.check">long_subdomain_label</field>
    <description>OpenCTI Add-on: Abnormally long DNS subdomain label - possible tunneling - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <rule id="101407" level="13">
    <if_matched_sid>101400</if_matched_sid>
    <field name="opencti.local.first_contact">^true$</field>
    <description>OpenCTI Add-on: First-ever contact with an already-flagged indicator - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_local_heuristic,</group>
  </rule>

</group>
