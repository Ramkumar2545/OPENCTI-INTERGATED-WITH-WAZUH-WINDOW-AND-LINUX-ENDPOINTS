<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SECTION 0 — Source Visibility Passthrough                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<group name="windows,powershell,process_creation,auditd,">

  <rule id="100690" level="3">
    <if_sid>91802</if_sid>
    <description>Windows: PowerShell script block logged - $(win.eventdata.ScriptBlockText)</description>
    <options>no_full_log</options>
    <group>windows,powershell,powershell_scriptblock,</group>
  </rule>

  <rule id="100691" level="3">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4688$</field>
    <description>Windows: Process created - $(win.eventdata.newProcessName)</description>
    <options>no_full_log</options>
    <group>windows,process_creation,windows_process_creation,</group>
  </rule>

  <rule id="100692" level="3">
    <if_group>audit</if_group>
    <field name="audit.key">^command_monitor$</field>
    <description>Linux: auditd monitored binary executed - $(audit.exe)</description>
    <options>no_full_log</options>
    <group>linux,auditd,linux_process_creation,</group>
  </rule>

</group>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SECTION 1 — OpenCTI Base Anchor (Required Parent)          -->
<!-- ═══════════════════════════════════════════════════════════ -->
<group name="threat_intel,opencti,">

  <rule id="100700" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^opencti$</field>
    <description>OpenCTI: Enrichment Result Received (anchor)</description>
    <options>no_log</options>
    <group>opencti,</group>
  </rule>

  <rule id="100701" level="5">
    <if_sid>100700</if_sid>
    <field name="opencti.error">.+</field>
    <description>OpenCTI Error: API Connection or Parse Failure</description>
    <options>no_full_log</options>
    <group>opencti,opencti_error,</group>
  </rule>

  <rule id="100702" level="12">
    <if_sid>100700</if_sid>
    <field name="opencti.event_type" type="pcre2">^indicator_(?:partial_)?pattern_match$</field>
    <description>OpenCTI Alert: Malicious $(opencti.ioc_type) [Score: $(opencti.indicator.x_opencti_score)] [Author: $(opencti.author_name)] - Target: $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_alert,opencti_alert_ind,</group>
  </rule>

  <rule id="100703" level="12">
    <if_sid>100700</if_sid>
    <field name="opencti.event_type" type="pcre2">^observable_with_(?:related_)?indicator$</field>
    <description>OpenCTI Alert: Observable + Indicator Match: $(opencti.ioc_type) [Score: $(opencti.indicator.x_opencti_score)] [Author: $(opencti.author_name)] - Target: $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_alert,opencti_alert_ind,</group>
  </rule>

  <rule id="100704" level="10">
    <if_sid>100700</if_sid>
    <field name="opencti.event_type" type="pcre2">^observable_without_indicator$</field>
    <description>OpenCTI Alert: $(opencti.ioc_type) in Threat Intel (No Indicator) [Score: $(opencti.observable.x_opencti_score)] [Author: $(opencti.author_name)] - Target: $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_alert,opencti_alert_obs,</group>
  </rule>

  <rule id="100705" level="13" frequency="5" timeframe="600">
    <if_matched_sid>100701</if_matched_sid>
    <description>OpenCTI Integration Health: 5+ API/Connection Errors in 10 Minutes - Enrichment Likely Down</description>
    <options>no_full_log</options>
    <group>opencti,opencti_health,</group>
  </rule>

</group>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SECTION 2 — Score Escalation                               -->
<!-- ═══════════════════════════════════════════════════════════ -->
<group name="opencti,opencti_high,">

  <rule id="100710" level="14">
    <if_group>opencti_alert_ind</if_group>
    <field name="opencti.indicator.x_opencti_score" type="pcre2">^(7[0-9]|8[0-9]|9[0-9]|100)$</field>
    <description>OpenCTI Critical: High-Score $(opencti.ioc_type) Indicator Match [Score: $(opencti.indicator.x_opencti_score)] [Author: $(opencti.author_name)] - Target: $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_high,</group>
  </rule>

  <rule id="100711" level="14">
    <if_group>opencti_alert_obs</if_group>
    <field name="opencti.observable.x_opencti_score" type="pcre2">^(7[0-9]|8[0-9]|9[0-9]|100)$</field>
    <description>OpenCTI Critical: High-Score $(opencti.ioc_type) Observable Match [Score: $(opencti.observable.x_opencti_score)] [Author: $(opencti.author_name)] - Target: $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_high,</group>
  </rule>

  <rule id="100712" level="15">
    <if_sid>100710,100711</if_sid>
    <description>OpenCTI CRITICAL [Score>=70]: Maximum Confidence Malicious $(opencti.ioc_type) [Author: $(opencti.author_name)] - Target: $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_high,opencti_critical,</group>
  </rule>

</group>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SECTION 3 — IoC Type-Specific Rules                        -->
<!-- ═══════════════════════════════════════════════════════════ -->
<group name="opencti,opencti_ip,">

  <rule id="100720" level="12">
    <if_group>opencti_alert_ind</if_group>
    <field name="opencti.ioc_type" type="pcre2">(?i)^ipv[46]$</field>
    <description>OpenCTI Alert: Malicious IP [Score: $(opencti.indicator.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_ip,</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <rule id="100721" level="12">
    <if_group>opencti_alert_obs</if_group>
    <field name="opencti.type" type="pcre2">(?i)^IPv[46]-Addr$</field>
    <description>OpenCTI Alert: Malicious IP Observable [Score: $(opencti.observable.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_ip,</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

</group>

<group name="opencti,opencti_domain,">

  <rule id="100725" level="12">
    <if_group>opencti_alert_ind</if_group>
    <field name="opencti.ioc_type" type="pcre2">(?i)^(?:domain|url)$</field>
    <description>OpenCTI Alert: Malicious $(opencti.ioc_type) [Score: $(opencti.indicator.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_domain,</group>
    <mitre>
      <id>T1071.001</id>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <rule id="100726" level="12">
    <if_group>opencti_alert_obs</if_group>
    <field name="opencti.type" type="pcre2">(?i)^(?:Domain-Name|Hostname|Url)$</field>
    <description>OpenCTI Alert: Malicious $(opencti.type) Observable [Score: $(opencti.observable.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_domain,</group>
    <mitre>
      <id>T1071.001</id>
      <id>T1071.004</id>
    </mitre>
  </rule>

</group>

<group name="opencti,opencti_hash,">

  <rule id="100730" level="12">
    <if_group>opencti_alert_ind</if_group>
    <field name="opencti.ioc_type" type="pcre2">(?i)^(?:sha256|sha1|md5)$</field>
    <description>OpenCTI Alert: Malicious File Hash ($(opencti.ioc_type), FIM) [Score: $(opencti.indicator.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_hash,</group>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100731" level="12">
    <if_group>opencti_alert_obs</if_group>
    <field name="opencti.type" type="pcre2">(?i)^(?:StixFile|Artifact)$</field>
    <description>OpenCTI Alert: Malicious File Hash Observable (FIM) [Score: $(opencti.observable.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_hash,</group>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100732" level="10">
    <if_group>opencti_alert</if_group>
    <field name="opencti.ioc_type" type="pcre2">^(?:filename|windows-registry-key)$</field>
    <description>OpenCTI Alert: Malicious $(opencti.ioc_type) Match (FIM) [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_hash,</group>
  </rule>

</group>

<group name="opencti,opencti_vuln,">

  <rule id="100735" level="12">
    <if_group>opencti_alert_ind</if_group>
    <field name="opencti.ioc_type" type="pcre2">(?i)^vulnerability$</field>
    <description>OpenCTI Alert: CVE Matched in Threat Intel [Score: $(opencti.indicator.x_opencti_score)] [Author: $(opencti.author_name)] - $(opencti.query_values)</description>
    <options>no_full_log</options>
    <group>opencti,opencti_vuln,</group>
